<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局主题：平台原生 Material 深色风格（零依赖），保持纯黑背景。
         原生 Theme.Material 自带 Material 控件样式（波纹/下划线/圆角），
         此处仅覆盖为纯黑底色 + 绿色点缀，最接近安卓原生观感。 -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
        <!-- 纯黑背景 -->
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- 原生控件配色：黑灰底 + 绿色点缀（终端风格延续） -->
        <item name="android:colorPrimary">#262626</item>
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:colorAccent">#4CAF50</item>
        <item name="android:colorButtonNormal">#262626</item>
        <item name="android:colorControlNormal">#555555</item>
        <item name="android:colorControlActivated">#4CAF50</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
        <item name="android:textColorHint">#707070</item>
        <!-- 启动加速：禁用所有窗口/Activity 过渡动画，跳过启动预览窗口 -->
        <item name="android:windowAnimationStyle">@style/NoAnimations</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- 空动画：全部置空，去除开启/关闭/任务切换动画，加快启动体验 -->
    <style name="NoAnimations" parent="@android:style/Animation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
        <item name="android:wallpaperOpenEnterAnimation">@null</item>
        <item name="android:wallpaperOpenExitAnimation">@null</item>
        <item name="android:wallpaperCloseEnterAnimation">@null</item>
        <item name="android:wallpaperCloseExitAnimation">@null</item>
        <item name="android:wallpaperIntraOpenEnterAnimation">@null</item>
        <item name="android:wallpaperIntraOpenExitAnimation">@null</item>
        <item name="android:wallpaperIntraCloseEnterAnimation">@null</item>
        <item name="android:wallpaperIntraCloseExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
</resources>
