<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 主内容：reasonix AI Agent 交互页面（CLI 输入输出） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#000000"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_menu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="&#9776;"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RSXM"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:padding="6dp"
                    android:text="&#9679;"
                    android:textColor="#4CAF50"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 标题栏分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E1E1E" />

            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 左侧侧滑配置菜单 -->
        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#000000"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#000000"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:text="配置"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/menu_adb"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="ADB 无线调试"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_apikey"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="API Key 配置"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_update"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="更新 reasonix"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_project"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="项目"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_skill"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="skill功能"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_bgmode"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="后台运行模式：关"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_root"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="Root 权限"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- 全屏功能面板（页面式切换，取代系统弹窗，避免遮挡控件）：
         ADB / API Key / 更新 / Root 等统一在此展示，默认隐藏 -->
    <LinearLayout
        android:id="@+id/panel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 面板标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#000000"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panel_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="&#8592;"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 关闭面板：返回箭头（←）+ 系统返回键，无需多余关闭按钮 -->
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E1E1E" />

        <!-- 面板内容区（各功能内容动态填充） -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
